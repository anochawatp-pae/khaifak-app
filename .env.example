# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงจาก Firebase Console
# (Project settings → General → Your apps → SDK setup and configuration)
# ค่าพวกนี้ไม่ใช่ความลับ ใส่ในโค้ดฝั่ง browser ได้ปกติ

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ค่านี้ "ห้าม" ใส่ในไฟล์ .env ของโปรเจกต์เว็บ (มันจะถูกฝังลงโค้ด browser ได้)
# ให้ไปตั้งใน Netlify → Site configuration → Environment variables แทนเท่านั้น
# GEMINI_API_KEY=
